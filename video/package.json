{
  "name": "finetune-launch-video",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render FineTuneLaunch out/finetune-launch.mp4 --codec=h264 --crf=18",
